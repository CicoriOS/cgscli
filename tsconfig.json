{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "types": ["bun-types"], "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src", "packages/*/test", "plugin/*/src", "scripts"]
}
