@@ -0,0 +1,28 @@
+// CGS channels (cgscli patch P8). A CGS channel speaks its vendor's own wire (Claude Code, Codex, Antigravity), but
+// omp keys the vendor's rules on the provider id, so `cgs-antigravity` / `cgs-codex` would fall back to the generic
+// wire of their api. These tables say which vendor rules a CGS channel borrows. Claude needs none: an
+// `anthropic-messages` provider already gets Claude Code's request shape from its api (custom-models.ts).
+
+export const CGS_ANTIGRAVITY_PROVIDER = "cgs-antigravity";
+
+/** Providers that speak Antigravity's Cloud Code Assist wire (request envelope, tool mode, thought-signature rules). */
+export function isAntigravityProvider(provider: string): boolean {
+	return provider === "google-antigravity" || provider === CGS_ANTIGRAVITY_PROVIDER;
+}
+
+/**
+ * The provider whose whole rule set (compat, wire and catalog axes) a provider resolves under. Antigravity's rules
+ * carry no prices or limits, so `cgs-antigravity` can take them as they are.
+ */
+export function ruleHostOf(provider: string): string {
+	return provider === CGS_ANTIGRAVITY_PROVIDER ? "google-antigravity" : provider;
+}
+
+/**
+ * Catalog axes a provider borrows from another provider's rules, and nothing else. `openai-codex` also carries the
+ * catalog's dollar prices, context windows and service-tier costs; a CGS channel prices and sizes its models itself.
+ */
+export const BORROWED_AXES: Readonly<Record<string, { host: string; axes: readonly string[] }>> = {
+	// Codex's freeform `apply_patch` tool: a custom tool with a grammar instead of a function tool called `edit`.
+	"cgs-codex": { host: "openai-codex", axes: ["applyPatchToolType"] },
+};
