+/**
+ * Cascade resolution plus the catalog axes a CGS channel borrows from its vendor's provider (cgs-style.ts): the
+ * donor's value replaces the channel's own only for those axes.
+ */
+function resolveStyled(target: ResolveTarget): ResolvedAxes {
+	const axes = resolveCascade(target);
+	const borrowed = BORROWED_AXES[target.provider];
+	if (borrowed === undefined) return axes;
+	const donor = resolveCascade({ ...target, provider: borrowed.host }).catalog;
+	const catalog = { ...axes.catalog };
+	for (const key of borrowed.axes) if (key in donor) catalog[key] = donor[key];
+	return { ...axes, catalog };
+}
+
