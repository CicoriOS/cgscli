+import { describe, expect, it } from "bun:test";
+import { buildModel } from "../src/build";
+import { isAntigravityProvider } from "../src/compat/cgs-style";
+import type { Api, Model, ModelSpec } from "../src/types";
+
+const cost = { input: 1.2, output: 6, cacheRead: 0.12, cacheWrite: 0 };
+
+function channelModel(provider: string, api: Api, id: string): Model<Api> {
+	return buildModel({
+		id, name: id, provider, api, baseUrl: "http://cgsconnect.invalid", reasoning: true, input: ["text"],
+		cost, contextWindow: 200_000, maxTokens: 32_000,
+	} as unknown as ModelSpec<Api>);
+}
+
+describe("CGS channels take their vendor's request style (cgscli patch P8)", () => {
+	it("cgs-antigravity resolves under Antigravity's rules: Gemini wire facts apply, prices and limits stay the channel's own", () => {
+		const m = channelModel("cgs-antigravity", "google-gemini-cli", "gemini-3.8-flash");
+		expect(m.compat).toMatchObject({
+			requiresSkipThoughtSignatureOnFirstFunctionCall: true,
+			flashStreamLeakWorkaround: true,
+			streamFirstEventTimeoutMs: 60_000,
+		});
+		expect(m.cost).toEqual(cost);
+		expect([m.contextWindow, m.maxTokens]).toEqual([200_000, 32_000]);
+		expect(isAntigravityProvider("cgs-antigravity")).toBe(true);
+		expect(isAntigravityProvider("google-antigravity")).toBe(true);
+		expect(isAntigravityProvider("google")).toBe(false);
+	});
+
+	it("cgs-codex borrows Codex's freeform apply_patch and nothing else: Codex's dollar prices and windows never replace the channel's", () => {
+		const m = channelModel("cgs-codex", "openai-codex-responses", "gpt-6-astra");
+		expect(m.applyPatchToolType).toBe("freeform");
+		expect(m.cost).toEqual(cost);
+		expect([m.contextWindow, m.maxTokens]).toEqual([200_000, 32_000]);
+		expect(m.serviceTierCost).toBeUndefined();
+	});
+
+	it("Claude and the generic channel are left alone", () => {
+		const claude = channelModel("cgs-claude", "anthropic-messages", "claude-haiku-5-5");
+		expect(claude.cost.input).toBe(1.2);
+		expect(claude.contextWindow).toBe(200_000);
+		expect(claude.applyPatchToolType).toBeUndefined();
+		const deepseek = channelModel("cgs-openai", "openai-completions", "deepseek-v4.1-flash");
+		expect(deepseek.cost).toEqual(cost);
+		expect(deepseek.applyPatchToolType).toBeUndefined();
+		expect(deepseek.compat).not.toHaveProperty("requiresSkipThoughtSignatureOnFirstFunctionCall", true);
+	});
+});
