@@ -0,0 +1,40 @@
+import { describe, expect, it } from "bun:test";
+import { getRecentRequests, initDb, insertMessageStats } from "@oh-my-pi/omp-stats/db";
+import type { MessageStats } from "@oh-my-pi/omp-stats/types";
+import { installStatsTestIsolation } from "./helpers/temp-agent";
+
+installStatsTestIsolation("@pi-stats-cgs-");
+
+function stats(provider: string, entryId: string): MessageStats {
+	return {
+		sessionFile: "/tmp/cgs-session.jsonl",
+		entryId,
+		folder: "/tmp/project",
+		model: "some-model",
+		provider,
+		api: "anthropic-messages",
+		timestamp: Date.now(),
+		duration: 1000,
+		ttft: 100,
+		stopReason: "stop",
+		errorMessage: null,
+		usage: {
+			input: 1000,
+			output: 500,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 1500,
+			cost: { input: 1, output: 2, cacheRead: 0, cacheWrite: 0, total: 3 },
+		},
+		agentType: "main",
+	} as MessageStats;
+}
+
+describe("CGS channels in omp's totals (cgscli patch P7)", () => {
+	it("records no cost for CGS channels, which the API relay bills; other providers keep theirs", async () => {
+		await initDb();
+		insertMessageStats([stats("anthropic", "a"), stats("cgs-claude", "b"), stats("cgs", "c")]);
+		const cost = Object.fromEntries(getRecentRequests(10).map(row => [row.provider, row.usage.cost.total]));
+		expect(cost).toEqual({ anthropic: 3, "cgs-claude": 0, cgs: 0 });
+	});
+});
