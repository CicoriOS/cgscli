@@ -0,0 +1,51 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { calculateCost } from "@oh-my-pi/pi-catalog/models";
+import { CGS_CURRENCY_ENV } from "../src/cgs-currency";
+import { formatProviderName } from "../src/modes/view-model/chrome/format";
+import { formatCostPair } from "../src/modes/view-model/overlays/model-browser";
+import { billingSummary } from "../src/ui/status/format";
+
+const model = (provider: string) =>
+	({ provider, id: "m", cost: { input: 1.2, output: 6, cacheRead: 0.12, cacheWrite: 1.5 } }) as never;
+const usage = () =>
+	({
+		input: 1_000_000,
+		output: 1_000_000,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 2_000_000,
+		cost: { input: 9, output: 9, cacheRead: 9, cacheWrite: 9, total: 36 },
+	}) as never;
+const symbols = { preset: "unicode", icon: () => "" } as never;
+const bill = (currency?: string) =>
+	billingSummary({ cost: 0.5, usingSubscription: false, premiumRequests: 0, digits: 2, ...(currency ? { currency } : {}) }, symbols);
+
+afterEach(() => {
+	delete process.env[CGS_CURRENCY_ENV];
+});
+
+describe("CGS channels (cgscli patch P7)", () => {
+	it("prices a CGS model in the relay's currency (a custom symbol, an emoji, keeps its space) and any other provider in dollars", () => {
+		expect(formatCostPair(model("cgs-claude"))).toBe("$1.2/6"); // currency not learned yet
+		process.env[CGS_CURRENCY_ENV] = "¥";
+		expect(formatCostPair(model("cgs-claude"))).toBe("¥1.2/6");
+		process.env[CGS_CURRENCY_ENV] = "🐱 ";
+		expect(formatCostPair(model("cgs-codex"))).toBe("🐱 1.2/6");
+		expect(formatCostPair(model("anthropic"))).toBe("$1.2/6");
+	});
+
+	it("prints the status line spend with the active provider's currency, dollars when none is given", () => {
+		expect(bill()).toBe("$0.50");
+		expect(bill("¥")).toBe("¥0.50");
+		expect(bill("HK$ ")).toBe("HK$ 0.50");
+	});
+
+	it("prices CGS usage like any other, so the session shows what it spent", () => {
+		expect(calculateCost(model("cgs-codex"), usage()).total).toBeCloseTo(7.2);
+	});
+
+	it("shows the login and every channel as Cicori Good Service, other providers as before", () => {
+		for (const id of ["cgs", "cgs-claude", "cgs-codex", "cgs-antigravity", "cgs-openai"]) expect(formatProviderName(id)).toBe("Cicori Good Service");
+		expect(formatProviderName("openai-codex")).toBe("Openai Codex");
+	});
+});
