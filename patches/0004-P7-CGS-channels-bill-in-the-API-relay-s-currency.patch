@@ -0,0 +1,24 @@
+// CGS (cgscli patch P7): the CGS login and its channels (`cgs`, `cgs-claude`, ...) are billed by the API relay, in the
+// relay's own currency, which is whatever the relay's console is set to show (yuan, dollars, or a custom symbol of up
+// to 8 characters, an emoji included). The extension reads it from the relay and exports it here; omp has no currency
+// of its own to guess from.
+
+/**
+ * Environment variable the CGS extension sets to the text printed before an amount: the relay's symbol (`¥`, `$`,
+ * `HK$`, `🐱`), followed by a space when the relay's console prints one (a custom symbol).
+ */
+export const CGS_CURRENCY_ENV = "CGS_CURRENCY_PREFIX";
+
+export function isCgsProvider(provider: string): boolean {
+	return provider === "cgs" || provider.startsWith("cgs-");
+}
+
+/** The relay's amount prefix; `$` until the extension has learned it. */
+export function cgsCurrencyPrefix(): string {
+	return process.env[CGS_CURRENCY_ENV] || "$";
+}
+
+/** Prefix to print before an amount spent with `provider`. */
+export function currencyPrefixFor(provider: string): string {
+	return isCgsProvider(provider) ? cgsCurrencyPrefix() : "$";
+}
