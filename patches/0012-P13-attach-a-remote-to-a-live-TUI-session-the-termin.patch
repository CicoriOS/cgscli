@@ -0,0 +1,187 @@
+/**
+ * Standby and takeover for a terminal session that a remote client is attached to (ADR 0027).
+ *
+ * While standing by, the local TUI keeps showing the running task and draft, but it is not the
+ * controlling end: only the allowlisted read-only commands and local-display keys run locally.
+ * Everything else takes over: the remote channel is revoked, the `taken_over` sentinel is sent
+ * on it, and it is closed. Policies are default-deny, so a command or key action added later
+ * takes over until someone allowlists it here.
+ */
+import type { TuiAttachHandle } from "../../extensibility/extensions/types";
+
+/** The frame sent on the remote channel right before the local TUI revokes it. */
+export const TAKEN_OVER_FRAME = { type: "taken_over" } as const;
+
+/**
+ * Grace after an Esc press during which another press extends the sequence (single, double, triple).
+ * [unverified V18]: the window matches the empty-draft double-Esc window; V18 must measure it.
+ */
+export const STANDBY_ESC_WINDOW_MS = 500;
+
+type ArgsPredicate = (args: string) => boolean;
+
+/**
+ * Slash commands that stay local while standing by, keyed by command name. A predicate decides
+ * per argument form: `/usage reset` and `/jobs kill` mutate and take over.
+ */
+const STANDBY_ALLOWED_COMMANDS: Record<string, ArgsPredicate> = {
+	changelog: () => true,
+	hotkeys: () => true,
+	usage: args => args === "" || args === "show",
+	jobs: args => args === "" || args === "full",
+};
+
+/**
+ * Keybinding actions that only change local display, scroll, or clipboard state. Anything else
+ * takes over.
+ */
+export const STANDBY_ALLOWED_KEY_ACTIONS: Record<string, true> = {
+	"app.tools.expand": true,
+	"app.tools.toggleVisibility": true,
+	"app.thinking.toggle": true,
+	"app.clipboard.copyLine": true,
+	"app.clipboard.copyPrompt": true,
+	"app.links.hint": true,
+	"app.display.reset": true,
+	"tui.select.pageUp": true,
+	"tui.select.pageDown": true,
+};
+
+export type StandbyEscAction = "takeover" | "stop" | "rewind";
+
+/** Esc semantics on standby: one press takes over, two also stop the task, three also rewind. */
+export function standbyEscAction(presses: number): StandbyEscAction {
+	if (presses >= 3) return "rewind";
+	if (presses === 2) return "stop";
+	return "takeover";
+}
+
+/** Whether a slash command, given its name and the raw argument text, runs locally while standing by. */
+export function isStandbyAllowedCommand(name: string, args: string): boolean {
+	if (!Object.hasOwn(STANDBY_ALLOWED_COMMANDS, name)) return false;
+	return STANDBY_ALLOWED_COMMANDS[name]!(args.trim());
+}
+
+/** Whether a draft is a slash command that runs locally while standing by. */
+export function isStandbyAllowedCommandText(text: string): boolean {
+	const trimmed = text.trim();
+	if (!trimmed.startsWith("/")) return false;
+	const body = trimmed.slice(1);
+	const space = body.search(/\s/);
+	const name = space === -1 ? body : body.slice(0, space);
+	const args = space === -1 ? "" : body.slice(space + 1);
+	return isStandbyAllowedCommand(name, args);
+}
+
+/** Whether a set of keybinding matches includes an allowlisted local action. */
+export function standbyAllowsKey(matches: (action: string) => boolean): boolean {
+	for (const action of Object.keys(STANDBY_ALLOWED_KEY_ACTIONS)) {
+		if (matches(action)) return true;
+	}
+	return false;
+}
+
+export interface StandbyControllerOptions {
+	/**
+	 * Opens the agent-side channel for the remote client, given its send callback. The controller
+	 * owns the returned handle while the remote client is attached.
+	 */
+	open(send: (line: string) => void): TuiAttachHandle;
+	/** Runs after an Esc sequence resolves: the mode performs the stop or rewind (takeover already done). */
+	onEscAction(action: Exclude<StandbyEscAction, "takeover">): void;
+	/** Called after standby begins or ends for any reason (takeover, remote close). */
+	onChange?(): void;
+	/** Delay before a single or double press acts, so a longer sequence can extend it. */
+	escWindowMs?: number;
+}
+
+/** Owns the remote channel while the session is in standby. Does not render anything. */
+export class StandbyController {
+	readonly #options: StandbyControllerOptions;
+	#handle: TuiAttachHandle | undefined;
+	#send: ((line: string) => void) | undefined;
+	#presses = 0;
+	#timer: NodeJS.Timeout | undefined;
+
+	constructor(options: StandbyControllerOptions) {
+		this.#options = options;
+	}
+
+	/** Whether a remote client currently owns the controls. */
+	get active(): boolean {
+		return this.#handle !== undefined;
+	}
+
+	/**
+	 * Binds a remote client, handed out through the `tui_attach` event. A second attach while one is
+	 * active is refused: the single control end is the first client.
+	 */
+	attach(send: (line: string) => void): TuiAttachHandle {
+		if (this.#handle) throw new Error("A remote client already controls this session.");
+		const handle = this.#options.open(send);
+		this.#handle = handle;
+		this.#send = send;
+		this.#options.onChange?.();
+		return {
+			receive: frame => {
+				if (this.#handle === handle) handle.receive(frame);
+			},
+			close: () => this.#release(handle, false),
+		};
+	}
+
+	/**
+	 * Revokes ownership, sends the `taken_over` sentinel, then closes the channel. Ownership is
+	 * removed first so no frame can arrive after the sentinel.
+	 */
+	takeOver(): void {
+		const handle = this.#handle;
+		if (!handle) return;
+		this.#release(handle, true);
+	}
+
+	/**
+	 * Handles an Esc press while standing by. Returns true when the press was consumed. Single and
+	 * double presses resolve after the window; the third resolves immediately.
+	 */
+	escape(): boolean {
+		if (!this.active) return false;
+		this.#presses += 1;
+		clearTimeout(this.#timer);
+		if (this.#presses >= 3) {
+			this.#resolveEsc();
+			return true;
+		}
+		this.#timer = setTimeout(() => this.#resolveEsc(), this.#options.escWindowMs ?? STANDBY_ESC_WINDOW_MS);
+		return true;
+	}
+
+	#resolveEsc(): void {
+		const presses = this.#presses;
+		this.#presses = 0;
+		this.#timer = undefined;
+		const action = standbyEscAction(presses);
+		this.takeOver();
+		if (action !== "takeover") this.#options.onEscAction(action);
+	}
+
+	#release(handle: TuiAttachHandle, sendTakenOver: boolean): void {
+		if (this.#handle !== handle) return;
+		const send = this.#send;
+		this.#handle = undefined;
+		this.#send = undefined;
+		clearTimeout(this.#timer);
+		this.#timer = undefined;
+		this.#presses = 0;
+		if (sendTakenOver) send?.(JSON.stringify(TAKEN_OVER_FRAME));
+		handle.close();
+		this.#options.onChange?.();
+	}
+
+	/** Releases timers and the channel without a sentinel (session shutdown). */
+	dispose(): void {
+		const handle = this.#handle;
+		if (!handle) return;
+		this.#release(handle, false);
+	}
+}
