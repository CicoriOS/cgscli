+				.catch(error => logger.warn("Could not clear RPC host tools", { error: String(error) }));
+		}
+		hostUriBridge.clear("RPC attachment is closed");
+		dictationBridge.dispose();
+		void liveBridge.stop().catch(error => logger.warn("Could not close RPC live voice", { error: String(error) }));
+		abortBuiltinCommands("RPC attachment is closed");
+		void btw.close().catch(error => logger.warn("Could not close RPC side question", { error: String(error) }));
+	};
+	if (localUI) {
+		unsubscribeEvents = subscribeEvents();
+		unsubscribePersistence = subscribePersistence();
+		unsubscribeMetadata = subscribeMetadata();
+		finishStartup();
+		announceReady();
+		void emitAvailableCommandsUpdate().catch(error =>
+			logger.warn("Could not publish RPC commands", { error: String(error) }),
+		);
+	}
+	return {
+		receive: receiveFrame,
+		disposeDictation: () => dictationBridge.dispose(),
+		close,
+		async runStdio(input: ReadableStream<Uint8Array>, writer: RpcOutputWriter): Promise<never> {
+			stdioWriter = writer;
+			const { inputRead } = await startStdio(input);
+			unsubscribeEvents = subscribeEvents();
+			await goalController.reconcile();
+			await goalController.settled();
+			unsubscribePersistence = subscribePersistence();
+			unsubscribeMetadata = subscribeMetadata();
+			await emitAvailableCommandsUpdate();
+			finishStartup();
+			await inputRead;
+			// Release side-channel waiters before draining work accepted before stdin closed.
+			pendingExtensionRequests.rejectAll("RPC client disconnected before extension UI response completed");
+			hostToolBridge.close("RPC client disconnected before host tool execution completed");
+			hostUriBridge.clear("RPC client disconnected before host URI request completed");
+			dictationBridge.dispose();
+			await liveBridge.stop();
+			await inputDispatcher.drain();
+			abortBuiltinCommands("RPC client disconnected");
+			if (session.isBackgroundCompacting) session.abortCompaction("RPC client disconnected");
+			await shutdownCoordinator.drain();
+			subagentRegistry?.dispose();
+			return disposeAndExit(writer);
+		},
+	};
 }
