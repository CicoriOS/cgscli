diff --git a/packages/coding-agent/test/interactive-mode-rpc-attach.test.ts b/packages/coding-agent/test/interactive-mode-rpc-attach.test.ts
new file mode 100644
index 0000000000..a815d546f7
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-rpc-attach.test.ts
@@ -0,0 +1,154 @@
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from "bun:test";
+import * as path from "node:path";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import { createMockModel, type MockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ExtensionRuntime, loadExtensionFromFactory } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/loader";
+import { ExtensionRunner } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/runner";
+import { InteractiveMode } from "@oh-my-pi/pi-coding-agent/modes/interactive-mode";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { EventBus } from "@oh-my-pi/pi-coding-agent/utils/event-bus";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { initTheme } from "../src/ui/theme/service";
+import { createModeTerminal, type ModeTerminal, pressKey } from "./helpers/mode-terminal";
+
+type Attach = (send: (line: string) => void) => { receive(frame: unknown): void; close(): void };
+type Frame = { type: string; id?: string; command?: string; method?: string; success?: boolean; timeout?: number };
+
+describe("RPC attach to an interactive session", () => {
+	let dir: TempDir;
+	let auth: AuthStorage;
+	let mock: MockModel;
+	let session: AgentSession;
+	let terminal: ModeTerminal;
+	let mode: InteractiveMode;
+	let attach: Attach;
+	let attachment: { receive(frame: unknown): void; close(): void } | undefined;
+	let frames: Frame[];
+	let changed: PromiseWithResolvers<void>;
+	let askAbort: AbortController;
+
+	beforeAll(() => initTheme());
+
+	beforeEach(async () => {
+		resetSettingsForTest();
+		dir = TempDir.createSync("@pi-tui-attach-");
+		const cwd = dir.path();
+		await Settings.init({ inMemory: true, cwd, overrides: { "startup.quiet": true } });
+		auth = await AuthStorage.create(path.join(cwd, "auth.db"));
+		auth.keys.setRuntime("anthropic", "test-key");
+		const registry = new ModelRegistry(auth, path.join(cwd, "models.yml"));
+		const manager = SessionManager.create(cwd, cwd);
+		const runtime = new ExtensionRuntime();
+		const eventBus = new EventBus();
+		const extension = await loadExtensionFromFactory(
+			pi =>
+				pi.on("tui_attach", event => {
+					attach = event.attach;
+				}),
+			cwd,
+			eventBus,
+			runtime,
+			"fake-remote",
+		);
+		const runner = new ExtensionRunner([extension], runtime, cwd, manager, registry);
+		mock = createMockModel({ handler: { content: ["visible on both terminals"] } });
+		session = new AgentSession({
+			agent: new Agent({
+				getApiKey: () => "test-key",
+				initialState: {
+					model: getBundledModel("anthropic", "claude-sonnet-4-5")!,
+					systemPrompt: ["Test"],
+					tools: [],
+				},
+				streamFn: mock.stream,
+			}),
+			sessionManager: manager,
+			settings: Settings.isolated({ "startup.quiet": true, "compaction.enabled": false }),
+			modelRegistry: registry,
+			extensionRunner: runner,
+		});
+		terminal = createModeTerminal({ columns: 120, rows: 34 });
+		await terminal.start();
+		mode = new InteractiveMode(session, "test", undefined, undefined, undefined, undefined, terminal.frame);
+		await mode.init({ suppressWelcomeIntro: true });
+		frames = [];
+		changed = Promise.withResolvers<void>();
+		askAbort = new AbortController();
+		attachment = attach(line => {
+			frames.push(JSON.parse(line));
+			changed.resolve();
+			changed = Promise.withResolvers<void>();
+		});
+	});
+
+	afterEach(async () => {
+		askAbort?.abort();
+		attachment?.close();
+		attachment = undefined;
+		mode?.stop();
+		await mode?.shell.stop();
+		terminal?.dispose();
+		await session?.dispose();
+		auth?.close();
+		dir?.removeSync();
+		resetSettingsForTest();
+	});
+
+	async function frame(match: (frame: Frame) => boolean): Promise<Frame> {
+		for (;;) {
+			const found = frames.find(match);
+			if (found) return found;
+			await changed.promise;
+		}
+	}
+
+	it("streams normal RPC frames to the browser and renders the same turn in the TUI", async () => {
+		await terminal.waitFor(rows =>
+			rows.some(row => row.includes("CGSConnected, standing by. Press Esc to take over.")),
+		);
+		attachment!.receive({ id: "remote-prompt", type: "prompt", message: "hello from remote" });
+		expect(await frame(f => f.type === "response" && f.id === "remote-prompt")).toMatchObject({ success: true });
+		await frame(f => f.type === "message_update");
+		await frame(f => f.type === "prompt_result" && f.id === "remote-prompt");
+		await frame(f => f.type === "session_settled");
+		await terminal.waitFor(rows => rows.some(row => row.includes("visible on both terminals")));
+
+		mode.composer.setText("/usage");
+		pressKey(mode.shell, "enter");
+		await terminal.settle();
+		expect(frames.some(f => f.type === "taken_over")).toBe(false);
+		mode.composer.setText("/rename terminal took control");
+		pressKey(mode.shell, "enter");
+		await frame(f => f.type === "taken_over");
+		await terminal.waitFor(rows => rows.every(row => !row.includes("CGSConnected, standing by.")));
+	}, 15_000);
+
+	it("a single Esc moves a pending ask to the TUI without interrupting the turn", async () => {
+		mock.push(async () => {
+			await session.extensionRunner!.getUIContext().askDialog!(
+				[{ id: "pending", question: "Choose after takeover", options: [{ label: "Keep going" }] }],
+				{ signal: askAbort.signal },
+			);
+			return { content: ["completed after takeover"] };
+		});
+		attachment!.receive({ id: "enable-ask", type: "set_ask_dialog", enabled: true });
+		await frame(f => f.id === "enable-ask" && f.success === true);
+		attachment!.receive({ id: "remote-prompt", type: "prompt", message: "ask before finishing" });
+		const pending = await frame(f => f.type === "extension_ui_request" && f.method === "ask");
+		expect(pending.timeout).toBeUndefined();
+		pressKey(mode.shell, "escape");
+		await frame(f => f.type === "taken_over");
+		attachment!.receive({ type: "extension_ui_response", id: pending.id, cancelled: true });
+		await terminal.waitFor(rows => rows.some(row => row.includes("Choose after takeover")));
+		expect(session.isStreaming).toBe(true);
+		askAbort.abort();
+		await session.waitForIdle();
+		await terminal.waitFor(rows => rows.some(row => row.includes("completed after takeover")));
+		expect(frames.filter(f => f.type === "taken_over")).toHaveLength(1);
+	}, 15_000);
+});
diff --git a/packages/coding-agent/test/standby-controller.test.ts b/packages/coding-agent/test/standby-controller.test.ts
new file mode 100644
index 0000000000..1e7635befd
--- /dev/null
+++ b/packages/coding-agent/test/standby-controller.test.ts
@@ -0,0 +1,90 @@
+import { describe, expect, it, vi } from "bun:test";
+import {
+	isStandbyAllowedCommandText,
+	StandbyController,
+	standbyAllowsKey,
+	standbyEscAction,
+} from "../src/modes/controllers/standby-controller";
+
+function controller(onEscAction: (action: "stop" | "rewind") => void = () => {}) {
+	const sent: string[] = [];
+	let closed = 0;
+	const standby = new StandbyController({
+		open: send => {
+			send('{"type":"ready"}');
+			return { receive() {}, close: () => void closed++ };
+		},
+		onEscAction,
+		escWindowMs: 500,
+	});
+	return { standby, sent, closed: () => closed, attach: () => standby.attach(line => sent.push(line)) };
+}
+
+describe("standby Esc and commands", () => {
+	it("maps one, two and three presses to takeover, stop and rewind", () => {
+		expect([1, 2, 3, 4].map(standbyEscAction)).toEqual(["takeover", "stop", "rewind", "rewind"]);
+	});
+
+	it("allows only read-only forms of whitelisted commands; unknown commands take over", () => {
+		expect(isStandbyAllowedCommandText("/usage")).toBe(true);
+		expect(isStandbyAllowedCommandText("/usage reset")).toBe(false);
+		expect(isStandbyAllowedCommandText("/rename x")).toBe(false);
+		expect(isStandbyAllowedCommandText("hello")).toBe(false);
+		expect(standbyAllowsKey(action => action === "app.tools.expand")).toBe(true);
+		expect(standbyAllowsKey(action => action === "app.model.cycleForward")).toBe(false);
+	});
+
+	it("a single Esc takes over after the window and tells the remote", () => {
+		vi.useFakeTimers();
+		try {
+			const actions: string[] = [];
+			const { standby, sent, closed, attach } = controller(a => actions.push(a));
+			attach();
+			expect(standby.escape()).toBe(true);
+			vi.advanceTimersByTime(499);
+			expect(standby.active).toBe(true);
+			vi.advanceTimersByTime(1);
+			expect(standby.active).toBe(false);
+			expect(sent.at(-1)).toBe('{"type":"taken_over"}');
+			expect(closed()).toBe(1);
+			expect(actions).toEqual([]);
+		} finally {
+			vi.useRealTimers();
+		}
+	});
+
+	it("a double Esc takes over and stops; a third press rewinds at once", () => {
+		vi.useFakeTimers();
+		try {
+			const actions: string[] = [];
+			const { standby, attach } = controller(a => actions.push(a));
+			attach();
+			standby.escape();
+			standby.escape();
+			vi.advanceTimersByTime(500);
+			expect(actions).toEqual(["stop"]);
+			attach();
+			standby.escape();
+			standby.escape();
+			standby.escape();
+			expect(actions).toEqual(["stop", "rewind"]);
+			expect(standby.active).toBe(false);
+		} finally {
+			vi.useRealTimers();
+		}
+	});
+
+	it("refuses a second remote and ignores frames after takeover", () => {
+		const received: unknown[] = [];
+		const standby = new StandbyController({
+			open: () => ({ receive: frame => received.push(frame), close() {} }),
+			onEscAction() {},
+		});
+		const handle = standby.attach(() => {});
+		expect(() => standby.attach(() => {})).toThrow("already controls");
+		handle.receive({ n: 1 });
+		standby.takeOver();
+		handle.receive({ n: 2 });
+		expect(received).toEqual([{ n: 1 }]);
+	});
+});
