@@ -1,5 +1,7 @@
 /** Title-case a provider id for display (`openai-codex` → `Openai Codex`). */
 export function formatProviderName(provider: string): string {
+	// The CGS login and its four channels (cgs-claude, cgs-codex, ...) are one service to the user.
+	if (provider === "cgs" || provider.startsWith("cgs-")) return "Cicori Good Service";
 	return provider
 		.split(/[-_]/g)
 		.map(part => (part ? part[0].toUpperCase() + part.slice(1) : ""))
