diff --git a/packages/catalog/src/models.ts b/packages/catalog/src/models.ts
index 51b877c..19d8cec 100644
--- a/packages/catalog/src/models.ts
+++ b/packages/catalog/src/models.ts
@@ -222,6 +222,11 @@ export function calculateUsageCost(cost: ModelCost, usage: Usage, timestamp?: nu
 
 /** Price usage at its request timestamp (Unix ms); preserve the resulting monetary amounts for display. */
 export function calculateCost<TApi extends Api>(model: Model<TApi>, usage: Usage, timestamp?: number): Usage["cost"] {
+	// CGS channels are billed by the relay (shown on /usage); omp records no cost for them.
+	if (model.provider.startsWith("cgs-")) {
+		usage.cost.input = usage.cost.output = usage.cost.cacheRead = usage.cost.cacheWrite = usage.cost.total = 0;
+		return usage.cost;
+	}
 	return calculateUsageCost(model.cost, usage, timestamp);
 }
 
