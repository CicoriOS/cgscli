--- /dev/null
+++ b/packages/coding-agent/test/collab/helpers/execute-live-session-command.ts
@@ -0,0 +1,12 @@
+import { LIVE_SESSION_SLASH_COMMANDS } from "@oh-my-pi/pi-coding-agent/slash-commands/builtin-collaboration";
+import { parseSlashCommand } from "@oh-my-pi/pi-coding-agent/slash-commands/helpers/parse";
+import type { TuiSlashCommandRuntime } from "@oh-my-pi/pi-coding-agent/slash-commands/types";
+
+/** Exercise the upstream handlers without registering them in the CGS command table. */
+export async function executeLiveSessionCommand(text: string, runtime: TuiSlashCommandRuntime): Promise<boolean> {
+	const parsed = parseSlashCommand(text);
+	const spec = parsed && LIVE_SESSION_SLASH_COMMANDS.find(cmd => cmd.name === parsed.name);
+	if (!parsed || !spec?.handleTui) throw new Error("Expected a live-session command");
+	await spec.handleTui(parsed, runtime);
+	return true;
+}
