+/**
+ * Update from the newest cgscli release (see {@link fetchCgsRelease}): the release's `cgscli` tarball is installed with
+ * `bun install -g`, which replaces the global package and every tarball it depends on.
+ */
+async function runCgsUpdate(opts: UpdateOptions): Promise<UpdateOutcome> {
+	console.log(chalk.dim(`Current version: ${VERSION}`));
+	const request: UpdateRequest = {
+		force: opts.force,
+		check: opts.check,
+		channel: "stable",
+		isChannelSwitch: false,
+		persistChannel: false,
+		onProgress: opts.onProgress,
+	};
+	let release: CgsRelease;
+	try {
+		release = await fetchCgsRelease();
+	} catch (err) {
+		throw updateError("Failed to check for updates", err);
+	}
+	if (!announceOffer(release.version, request)) return { kind: "current" };
+	if (request.check) return { kind: "available", version: release.version };
+
+	const lock = acquireInstallLock();
+	try {
+		request.onProgress?.({ phase: "installing", version: release.version });
+		const exitCode = await runInstaller(["bun", "install", "-g", release.tarball]);
+		if (exitCode !== 0) throw new Error(`bun install failed with exit code ${exitCode}`);
+		await finishVerifiedUpdate(await verifyInstalledVersion(release.version), release.version);
+	} catch (err) {
+		throw updateError("Update failed", err);
+	} finally {
+		lock.release();
+	}
+	return { kind: "installed", version: release.version };
+}
