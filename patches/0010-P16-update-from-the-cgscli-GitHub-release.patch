+/**
+ * CGS release source: where `cgs update` and the startup update check look for a newer build.
+ *
+ * A release of cgscli is a GitHub release whose assets are npm tarballs plus a `latest.json` describing the newest one:
+ * `{ "version": "19.2.1-cgs.3", "tarball": "https://github.com/<owner>/cgscli/releases/download/v19.2.1-cgs.3/cgscli-19.2.1-cgs.3.tgz" }`.
+ * `latest.json` is read from `<release url>/latest.json`; `releases/latest/download/` redirects to the newest release, so no
+ * API (and no API rate limit) is involved. Omp's own channels (npm, the build service) are never asked: they would replace
+ * this build with upstream omp. `CGS_RELEASE_URL` replaces the base (a mirror, or a local server in tests).
+ */
+import { $env, VERSION } from "@oh-my-pi/pi-utils";
+
+/** Where the newest release's assets live when `CGS_RELEASE_URL` is unset. */
+export const CGS_RELEASE_URL = "https://github.com/CicoriOS/cgscli/releases/latest/download";
+
+export interface CgsRelease {
+	/** `<omp version>-cgs.<n>`. */
+	version: string;
+	/** The `cgscli` package tarball `bun install -g` installs. */
+	tarball: string;
+}
+
+const VERSION_RE = /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/;
+const LOOPBACK_HOSTS: Record<string, true> = { localhost: true, "127.0.0.1": true, "[::1]": true };
+
+/** The release description `latest.json` holds. Throws on anything else: a wrong answer must never reach the installer. */
+export function parseCgsRelease(data: unknown): CgsRelease {
+	if (typeof data !== "object" || data === null || !("version" in data) || !("tarball" in data)) {
+		throw new Error("latest.json must hold a version and a tarball");
+	}
+	const { version, tarball } = data;
+	if (typeof version !== "string" || !VERSION_RE.test(version)) throw new Error("latest.json has an invalid version");
+	if (typeof tarball !== "string") throw new Error("latest.json has an invalid tarball");
+	const url = new URL(tarball);
+	// Plain http only for a local test server: the tarball is code that is about to be installed.
+	if (url.protocol !== "https:" && !(url.protocol === "http:" && LOOPBACK_HOSTS[url.hostname])) {
+		throw new Error(`latest.json names a tarball that is not https: ${tarball}`);
+	}
+	return { version, tarball };
+}
+
+/** The newest CGS release. */
+export async function fetchCgsRelease(timeoutMs = 30_000): Promise<CgsRelease> {
+	const base = ($env.CGS_RELEASE_URL ?? "").trim().replace(/\/+$/, "") || CGS_RELEASE_URL;
+	const response = await fetch(`${base}/latest.json`, {
+		signal: AbortSignal.timeout(timeoutMs),
+		headers: { "user-agent": `cgs/${VERSION}` },
+	});
+	if (!response.ok) throw new Error(`${base}/latest.json answered HTTP ${response.status}`);
+	return parseCgsRelease(await response.json());
+}
