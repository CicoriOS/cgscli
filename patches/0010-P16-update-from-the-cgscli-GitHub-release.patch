+import { afterEach, describe, expect, test } from "bun:test";
+import { fetchCgsRelease, parseCgsRelease } from "../src/cli/cgs-release";
+
+describe("parseCgsRelease", () => {
+	test("accepts a version with the cgs suffix and an https tarball", () => {
+		expect(parseCgsRelease({ version: "19.2.1-cgs.3", tarball: "https://github.com/x/cgscli/releases/download/v19.2.1-cgs.3/cgscli-19.2.1-cgs.3.tgz" })).toEqual({
+			version: "19.2.1-cgs.3",
+			tarball: "https://github.com/x/cgscli/releases/download/v19.2.1-cgs.3/cgscli-19.2.1-cgs.3.tgz",
+		});
+	});
+
+	test("allows plain http only for a loopback server", () => {
+		expect(parseCgsRelease({ version: "1.0.0", tarball: "http://127.0.0.1:8123/cgscli.tgz" }).tarball).toBe("http://127.0.0.1:8123/cgscli.tgz");
+		expect(() => parseCgsRelease({ version: "1.0.0", tarball: "http://example.com/cgscli.tgz" })).toThrow("not https");
+	});
+
+	test("refuses anything that is not a version and a tarball", () => {
+		expect(() => parseCgsRelease(null)).toThrow();
+		expect(() => parseCgsRelease({ version: "1.0.0" })).toThrow();
+		expect(() => parseCgsRelease({ version: "latest", tarball: "https://x/y.tgz" })).toThrow("invalid version");
+		expect(() => parseCgsRelease({ version: "1.0.0", tarball: 5 })).toThrow("invalid tarball");
+	});
+});
+
+describe("fetchCgsRelease", () => {
+	const saved = process.env.CGS_RELEASE_URL;
+	afterEach(() => {
+		if (saved === undefined) delete process.env.CGS_RELEASE_URL;
+		else process.env.CGS_RELEASE_URL = saved;
+	});
+
+	test("reads latest.json from CGS_RELEASE_URL and sends no omp channel request", async () => {
+		const seen: string[] = [];
+		using server = Bun.serve({
+			port: 0,
+			hostname: "127.0.0.1",
+			fetch(req) {
+				seen.push(new URL(req.url).pathname);
+				return Response.json({ version: "19.2.1-cgs.2", tarball: `http://127.0.0.1:${server.port}/cgscli-19.2.1-cgs.2.tgz` });
+			},
+		});
+		process.env.CGS_RELEASE_URL = `http://127.0.0.1:${server.port}/releases/`;
+		expect((await fetchCgsRelease()).version).toBe("19.2.1-cgs.2");
+		expect(seen).toEqual(["/releases/latest.json"]);
+	});
+
+	test("a missing release is an error naming the status", async () => {
+		using server = Bun.serve({ port: 0, hostname: "127.0.0.1", fetch: () => new Response("nope", { status: 404 }) });
+		process.env.CGS_RELEASE_URL = `http://127.0.0.1:${server.port}`;
+		await expect(fetchCgsRelease()).rejects.toThrow("HTTP 404");
+	});
+});
