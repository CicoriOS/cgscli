--- a/packages/coding-agent/src/main.ts
+++ b/packages/coding-agent/src/main.ts
@@ -274,6 +274,9 @@ async function checkForNewVersion(currentVersion: string): Promise<string | unde
 		return;
 	}
 	try {
+		// Branded build: without a CGS build service (PI_BUILD_URL) there is no source to update from, and the
+		// stock omp registry/build service would replace this build with upstream omp.
+		if (!$env.PI_BUILD_URL?.trim()) return;
 		// Checkouts update through git and a manager (Tern) updates its omp itself:
