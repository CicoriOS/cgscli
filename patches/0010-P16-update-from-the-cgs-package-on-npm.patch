@@ -0,0 +1,66 @@
+/**
+ * CGS release source: where `cgs update` and the startup update check look for a newer build.
+ *
+ * A release of cgscli is a version of the npm package `@cicori/cgs`. The `latest` document of the package names the
+ * newest version and the tarball `bun install -g` installs. Two registries are asked at once and the first answer wins:
+ * the npm registry, and npmmirror (reachable from mainland China, a few minutes behind). Omp's own channels (its npm
+ * package, the build service) are never asked: they would replace this build with upstream omp.
+ * `CGS_REGISTRY_URL` replaces the registry list with one registry (a private mirror, or a local server in tests).
+ */
+import { $env, VERSION } from "@oh-my-pi/pi-utils";
+
+/** The package a release is published as. */
+export const CGS_PACKAGE = "@cicori/cgs";
+
+/** Registries asked when `CGS_REGISTRY_URL` is unset. */
+export const CGS_REGISTRIES = ["https://registry.npmjs.org", "https://registry.npmmirror.com"];
+
+export interface CgsRelease {
+	/** `<omp version>-cgs.<n>`. */
+	version: string;
+	/** The package tarball `bun install -g` installs. */
+	tarball: string;
+	/** The registry that answered; the install resolves the tarball's dependencies there too. */
+	registry: string;
+}
+
+const VERSION_RE = /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/;
+const LOOPBACK_HOSTS: Record<string, true> = { localhost: true, "127.0.0.1": true, "[::1]": true };
+
+/** The `latest` document of the package. Throws on anything else: a wrong answer must never reach the installer. */
+export function parseCgsRelease(data: unknown, registry: string): CgsRelease {
+	if (typeof data !== "object" || data === null || !("version" in data) || !("dist" in data)) {
+		throw new Error("The registry answer must hold a version and a dist");
+	}
+	const { version, dist } = data;
+	if (typeof version !== "string" || !VERSION_RE.test(version)) throw new Error("The registry answer has an invalid version");
+	if (typeof dist !== "object" || dist === null || !("tarball" in dist) || typeof dist.tarball !== "string") {
+		throw new Error("The registry answer has an invalid tarball");
+	}
+	const tarball = dist.tarball;
+	const url = new URL(tarball);
+	// Plain http only for a local test server: the tarball is code that is about to be installed.
+	if (url.protocol !== "https:" && !(url.protocol === "http:" && LOOPBACK_HOSTS[url.hostname])) {
+		throw new Error(`The registry names a tarball that is not https: ${tarball}`);
+	}
+	return { version, tarball, registry };
+}
+
+/** The newest CGS release: the first registry to answer. */
+export async function fetchCgsRelease(timeoutMs = 30_000): Promise<CgsRelease> {
+	const override = ($env.CGS_REGISTRY_URL ?? "").trim().replace(/\/+$/, "");
+	const registries = override ? [override] : CGS_REGISTRIES;
+	const asks = registries.map(async registry => {
+		const response = await fetch(`${registry}/${CGS_PACKAGE.replace("/", "%2f")}/latest`, {
+			signal: AbortSignal.timeout(timeoutMs),
+			headers: { "user-agent": `cgs/${VERSION}`, accept: "application/json" },
+		});
+		if (!response.ok) throw new Error(`${registry} answered HTTP ${response.status}`);
+		return parseCgsRelease(await response.json(), registry);
+	});
+	try {
+		return await Promise.any(asks);
+	} catch (err) {
+		throw new Error((err as AggregateError).errors.map((e: unknown) => (e instanceof Error ? e.message : String(e))).join("; "));
+	}
+}
