@@ -0,0 +1,54 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { fetchCgsRelease, parseCgsRelease } from "../src/cli/cgs-release";
+
+const REGISTRY = "https://registry.npmjs.org";
+
+describe("parseCgsRelease", () => {
+	test("accepts a version with the cgs suffix and an https tarball", () => {
+		const tarball = "https://registry.npmjs.org/@cicori/cgs/-/cgs-19.2.1-cgs.3.tgz";
+		expect(parseCgsRelease({ version: "19.2.1-cgs.3", dist: { tarball } }, REGISTRY)).toEqual({ version: "19.2.1-cgs.3", tarball, registry: REGISTRY });
+	});
+
+	test("allows plain http only for a loopback server", () => {
+		expect(parseCgsRelease({ version: "1.0.0", dist: { tarball: "http://127.0.0.1:8123/cgs.tgz" } }, REGISTRY).tarball).toBe("http://127.0.0.1:8123/cgs.tgz");
+		expect(() => parseCgsRelease({ version: "1.0.0", dist: { tarball: "http://example.com/cgs.tgz" } }, REGISTRY)).toThrow("not https");
+	});
+
+	test("refuses anything that is not a version and a tarball", () => {
+		expect(() => parseCgsRelease(null, REGISTRY)).toThrow();
+		expect(() => parseCgsRelease({ version: "1.0.0" }, REGISTRY)).toThrow();
+		expect(() => parseCgsRelease({ version: "latest", dist: { tarball: "https://x/y.tgz" } }, REGISTRY)).toThrow("invalid version");
+		expect(() => parseCgsRelease({ version: "1.0.0", dist: { tarball: 5 } }, REGISTRY)).toThrow("invalid tarball");
+	});
+});
+
+describe("fetchCgsRelease", () => {
+	const saved = process.env.CGS_REGISTRY_URL;
+	afterEach(() => {
+		if (saved === undefined) delete process.env.CGS_REGISTRY_URL;
+		else process.env.CGS_REGISTRY_URL = saved;
+	});
+
+	test("reads the package's latest document from CGS_REGISTRY_URL and sends no omp channel request", async () => {
+		const seen: string[] = [];
+		let origin = "";
+		using server = Bun.serve({
+			port: 0,
+			hostname: "127.0.0.1",
+			fetch(req) {
+				seen.push(new URL(req.url).pathname);
+				return Response.json({ version: "19.2.1-cgs.2", dist: { tarball: `${origin}/cgs-19.2.1-cgs.2.tgz` } });
+			},
+		});
+		origin = `http://127.0.0.1:${server.port}`;
+		process.env.CGS_REGISTRY_URL = `${origin}/`;
+		expect(await fetchCgsRelease()).toEqual({ version: "19.2.1-cgs.2", tarball: `${origin}/cgs-19.2.1-cgs.2.tgz`, registry: origin });
+		expect(seen).toEqual(["/@cicori%2fcgs/latest"]);
+	});
+
+	test("a missing package is an error naming the status", async () => {
+		using server = Bun.serve({ port: 0, hostname: "127.0.0.1", fetch: () => new Response("nope", { status: 404 }) });
+		process.env.CGS_REGISTRY_URL = `http://127.0.0.1:${server.port}`;
+		await expect(fetchCgsRelease()).rejects.toThrow("HTTP 404");
+	});
+});
