diff --git a/packages/ai/test/cgs-session.test.ts b/packages/ai/test/cgs-session.test.ts
new file mode 100644
index 0000000000..c07aa03da0
--- /dev/null
+++ b/packages/ai/test/cgs-session.test.ts
@@ -0,0 +1,75 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { withCgsSessionIdentity } from "../src/cgs-session";
+import { ANTHROPIC_PROVIDER_SESSION_STATE_KEY, anthropicProviderSessionStateKey } from "../src/providers/anthropic-state";
+import { getAntigravityProviderSessionState } from "../src/providers/google-gemini-cli";
+import type { ProviderSessionState } from "../src/types";
+
+const HOOK = Symbol.for("cgscli.sessionIdentity");
+type States = Map<string, ProviderSessionState>;
+
+/** The resolver cgsconnect installs: per channel epoch, a different wire id per base session. */
+function install(epochs: Record<string, number>): void {
+	Reflect.set(globalThis, HOOK, (provider: string, base: string) => ((epochs[provider] ?? 0) === 0 ? base : `${base}#${provider}#${epochs[provider]}`));
+}
+
+afterEach(() => {
+	Reflect.deleteProperty(globalThis, HOOK);
+});
+
+function claudeThreads(states: States): Map<string, unknown> {
+	const state = { close: () => {}, threads: new Map<string, unknown>([["t1", {}]]) };
+	states.set(anthropicProviderSessionStateKey("http://cgsconnect.invalid", "claude-haiku-5-5"), state);
+	return state.threads;
+}
+
+describe("CGS session identity switch (cgscli patch P9)", () => {
+	it("leaves other providers and a missing resolver alone", () => {
+		const options = { sessionId: "s1", providerSessionState: new Map() as States };
+		expect(withCgsSessionIdentity("cgs-claude", options)).toBe(options);
+		install({ anthropic: 3, "cgs-claude": 3 });
+		expect(withCgsSessionIdentity("anthropic", options)).toBe(options);
+	});
+
+	it("puts the channel's current wire id on the request, and keeps it while the epoch holds", () => {
+		const options = { sessionId: "s1", providerSessionState: new Map() as States };
+		install({});
+		expect(withCgsSessionIdentity("cgs-claude", options).sessionId).toBe("s1");
+		install({ "cgs-claude": 1 });
+		expect(withCgsSessionIdentity("cgs-claude", options).sessionId).toBe("s1#cgs-claude#1");
+		expect(withCgsSessionIdentity("cgs-claude", options).sessionId).toBe("s1#cgs-claude#1");
+		expect(withCgsSessionIdentity("cgs-codex", options).sessionId).toBe("s1");
+	});
+
+	it("a new identity clears what the old one left: Claude threads and Antigravity ids, never the endpoint", () => {
+		const states: States = new Map();
+		const threads = claudeThreads(states);
+		const agy = getAntigravityProviderSessionState(states)!;
+		Object.assign(agy, { lastGoodEndpoint: "http://e", agentId: "a", trajectoryId: "t", sessionId: "7", stepIndex: 4, requestCount: 2, lastExecutionId: "x" });
+		install({});
+		withCgsSessionIdentity("cgs-claude", { sessionId: "s1", providerSessionState: states });
+		expect(threads.size).toBe(1); // a first sighting only records
+		install({ "cgs-claude": 1 });
+		withCgsSessionIdentity("cgs-claude", { sessionId: "s1", providerSessionState: states });
+		expect(threads.size).toBe(0);
+		expect(agy).toMatchObject({ lastGoodEndpoint: "http://e", agentId: undefined, trajectoryId: undefined, sessionId: undefined, stepIndex: undefined, requestCount: undefined, lastExecutionId: undefined });
+		// later calls in the same epoch do not clear again
+		threads.set("t2", {});
+		withCgsSessionIdentity("cgs-claude", { sessionId: "s1", providerSessionState: states });
+		expect(threads.size).toBe(1);
+	});
+
+	it("the main agent and a subagent (own session id, own state map) both follow the switch", () => {
+		const main: States = new Map();
+		const sub: States = new Map();
+		const mainThreads = claudeThreads(main);
+		const subThreads = claudeThreads(sub);
+		install({});
+		withCgsSessionIdentity("cgs-claude", { sessionId: "main", providerSessionState: main });
+		withCgsSessionIdentity("cgs-claude", { sessionId: "sub", providerSessionState: sub });
+		install({ "cgs-claude": 1 });
+		expect(withCgsSessionIdentity("cgs-claude", { sessionId: "main", providerSessionState: main }).sessionId).toBe("main#cgs-claude#1");
+		expect(withCgsSessionIdentity("cgs-claude", { sessionId: "sub", providerSessionState: sub }).sessionId).toBe("sub#cgs-claude#1");
+		expect([mainThreads.size, subThreads.size]).toEqual([0, 0]);
+		expect(ANTHROPIC_PROVIDER_SESSION_STATE_KEY).toBe("anthropic-messages");
+	});
+});
