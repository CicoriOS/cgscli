--- /dev/null
+++ b/packages/ai/src/cgs-session.ts
@@ -0,0 +1,68 @@
+// CGS channels (cgscli patch P9): the session identity a request carries toward the relay can be switched at runtime.
+//
+// The relay chooses the upstream account; the client's whole answer to "move on to another account" is to look like a
+// new conversation: a new wire session id (Claude Code's `/new`) while the transcript stays the old one. cgsconnect
+// (loaded in-process by the cgs extension) installs a resolver under a well-known symbol, so the extension needs no
+// import of omp internals; the resolver maps (provider, session id) to the id to put on the wire for the current
+// epoch. Every model call funnels through `streamDispatch`, so the main agent, subagents, compaction and side
+// requests all follow the same switch, each with its own `providerSessionState`.
+import { getAntigravityProviderSessionState } from "./providers/google-gemini-cli";
+import { resetAccountScopedProviderSessionState } from "./provider-session-state";
+import type { ProviderSessionState } from "./types";
+
+const IDENTITY_HOOK = Symbol.for("cgscli.sessionIdentity");
+type IdentityHook = (provider: string, sessionId: string) => string;
+
+const MARKER_PREFIX = "cgs-session-identity:";
+
+interface IdentityMarker extends ProviderSessionState {
+	wireSessionId: string;
+}
+
+interface IdentityOptions {
+	sessionId?: string;
+	providerSessionState?: Map<string, ProviderSessionState>;
+}
+
+/**
+ * What a channel remembers about the previous identity and must not carry into the next one: Claude's message-thread
+ * chains and the other account-scoped records omp itself forgets on an account switch, and the Antigravity
+ * agent/trajectory/session ids (conversation-scoped to omp, identity to the relay). `lastGoodEndpoint` is endpoint
+ * state and stays.
+ */
+function forgetPreviousIdentity(states: Map<string, ProviderSessionState>): void {
+	resetAccountScopedProviderSessionState(states);
+	const agy = getAntigravityProviderSessionState(states);
+	if (agy) {
+		agy.agentId = undefined;
+		agy.trajectoryId = undefined;
+		agy.sessionId = undefined;
+		agy.stepIndex = undefined;
+		agy.requestCount = undefined;
+		agy.lastExecutionId = undefined;
+	}
+}
+
+/**
+ * Options with the wire session id for `provider`'s current identity. A first sighting only records the id; a changed
+ * id clears what the previous identity left in `providerSessionState`. Providers other than `cgs-*` pass through.
+ */
+export function withCgsSessionIdentity<T extends IdentityOptions>(provider: string, options: T): T {
+	if (!provider.startsWith("cgs-") || options.sessionId === undefined) return options;
+	const hook = Reflect.get(globalThis, IDENTITY_HOOK);
+	if (typeof hook !== "function") return options;
+	const wire = (hook as IdentityHook)(provider, options.sessionId);
+	const states = options.providerSessionState;
+	if (states) {
+		const key = `${MARKER_PREFIX}${provider}`;
+		const marker = states.get(key) as IdentityMarker | undefined;
+		if (marker === undefined) {
+			const created: IdentityMarker = { close: () => {}, wireSessionId: wire };
+			states.set(key, created);
+		} else if (marker.wireSessionId !== wire) {
+			forgetPreviousIdentity(states);
+			marker.wireSessionId = wire;
+		}
+	}
+	return wire === options.sessionId ? options : { ...options, sessionId: wire };
+}
