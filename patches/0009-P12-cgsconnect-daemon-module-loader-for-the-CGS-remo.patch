diff --git a/packages/coding-agent/test/daemon/cgsconnect-module.test.ts b/packages/coding-agent/test/daemon/cgsconnect-module.test.ts
new file mode 100644
index 0000000000..efeb74791a
--- /dev/null
+++ b/packages/coding-agent/test/daemon/cgsconnect-module.test.ts
@@ -0,0 +1,76 @@
+import { afterEach, beforeEach, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import type { ModuleClient, ModuleContext, ModuleOpen } from "../../src/daemon/module";
+import { cgsconnectModule, type CgsconnectUnit } from "../../src/daemon/modules/cgsconnect";
+import { DAEMON_MODULES } from "../../src/daemon/modules";
+import { GLOBAL_SCOPE } from "../../src/daemon/protocol";
+
+const CLIENT: ModuleClient = { connectionId: "cgsconnect-test", pid: process.pid, build: "test" };
+
+let root: string;
+beforeEach(() => {
+	root = fs.mkdtempSync(path.join(os.tmpdir(), "omp-cgsconnect-module-"));
+});
+afterEach(() => {
+	fs.rmSync(root, { recursive: true, force: true });
+});
+
+function context(): ModuleContext {
+	return { stateDir: path.join(root, "state") } as ModuleContext;
+}
+
+function openRequest(params: unknown): ModuleOpen {
+	return { unitId: "u1", scope: GLOBAL_SCOPE, key: "device-a", params, client: CLIENT };
+}
+
+function writeImpl(body: string): string {
+	const file = path.join(root, "impl.mjs");
+	fs.writeFileSync(file, body);
+	return file;
+}
+
+const IMPL = `
+export function open(stateDir, key, params) {
+	const exited = Promise.withResolvers();
+	return {
+		label: "device " + key,
+		ready: Promise.resolve(),
+		exited: exited.promise,
+		pids: () => [],
+		busy: () => false,
+		attach() {},
+		async stop() { exited.resolve({}); },
+		async invoke(method, args) { return { method, args, stateDir, key, seen: params.impl.endsWith("impl.mjs") }; },
+	};
+}`;
+
+it("is registered with the daemon", () => {
+	expect(DAEMON_MODULES.map(module => module.kind)).toContain("cgsconnect");
+});
+
+it("loads the unit from params.impl, keys it, and forwards calls to it", async () => {
+	const unit = (await cgsconnectModule.open(context(), openRequest({ impl: writeImpl(IMPL) }))) as CgsconnectUnit;
+	expect(unit.label).toBe("device device-a");
+	const reply = await cgsconnectModule.call?.(context(), "status", { a: 1 }, CLIENT, {
+		snapshot: {} as never,
+		unit,
+	});
+	expect(reply).toEqual({ method: "status", args: { a: 1 }, stateDir: path.join(root, "state"), key: "device-a", seen: true });
+});
+
+it("refuses an impl that is not an absolute path to a module with open()", async () => {
+	await expect(cgsconnectModule.open(context(), openRequest({}))).rejects.toThrow("params.impl");
+	await expect(cgsconnectModule.open(context(), openRequest({ impl: "relative.mjs" }))).rejects.toThrow("params.impl");
+	await expect(cgsconnectModule.open(context(), openRequest({ impl: path.join(root, "missing.mjs") }))).rejects.toThrow(
+		"params.impl",
+	);
+	await expect(cgsconnectModule.open(context(), openRequest({ impl: writeImpl("export const x = 1;") }))).rejects.toThrow(
+		"does not export open()",
+	);
+});
+
+it("holds the unit only while a process leases it", () => {
+	expect(cgsconnectModule.policy({})).toMatchObject({ hold: "leases", idleMs: 0, onIdle: "stop", survive: "none" });
+});
