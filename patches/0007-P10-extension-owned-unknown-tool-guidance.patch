+++ b/packages/agent/src/agent-loop.ts
@@ -39,6 +39,9 @@ import {
 	copyCursorExecResolved,
 	getStreamingPartialJson,
 	kCursorExecResolved,
+	kRequestToolRoster,
+	kUnknownToolGuidance,
+	type RequestToolRosterCarrier,
 } from "@oh-my-pi/pi-ai/utils/block-symbols";
