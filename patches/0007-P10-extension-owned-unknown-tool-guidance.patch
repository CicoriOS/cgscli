@@ -0,0 +1,105 @@
+import { expect, test } from "bun:test";
+import { type } from "@oh-my-pi/omptype";
+import { agentLoop } from "@oh-my-pi/pi-agent-core/agent-loop";
+import type { AgentTool } from "@oh-my-pi/pi-agent-core/types";
+import type { FetchImpl, Message, ToolCall } from "@oh-my-pi/pi-ai";
+import { streamAnthropic } from "@oh-my-pi/pi-ai/providers/anthropic";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+import { createUserMessage } from "./helpers";
+
+const model = buildModel({
+	id: "claude-sonnet-4-6",
+	name: "Sonnet",
+	api: "anthropic-messages",
+	provider: "anthropic",
+	baseUrl: "https://example.test",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 64_000,
+	maxTokens: 4096,
+});
+
+function sse(events: Record<string, unknown>[]): Response {
+	return new Response(events.map(event => `event: ${event.type}\ndata: ${JSON.stringify(event)}\n\n`).join(""), {
+		headers: { "content-type": "text/event-stream" },
+	});
+}
+
+for (const branch of ["prepare", "execute"] as const) {
+	test(`unknown-tool guidance sees the wire roster on a ${branch} miss without replacing fallback resolution`, async () => {
+		const hook = Symbol.for("cgscli.unknownToolGuidance");
+		const previous = Object.getOwnPropertyDescriptor(globalThis, hook);
+		const guidanceInputs: unknown[] = [];
+		const resultByName: Record<string, { content: unknown; isError: boolean }> = {};
+		const usage = { input_tokens: 10, output_tokens: 8 };
+		const requestBodies: unknown[] = [];
+		const fetch: FetchImpl = async (input, init) => {
+			const body: unknown = await new Request(input, init).json();
+			requestBodies.push(body);
+			return sse([
+				{ type: "message_start", message: { id: "msg", model: model.id, usage } },
+				...(requestBodies.length === 1
+					? ["UnknownTool", "mcp_alias"].flatMap((name, index) => [
+							{ type: "content_block_start", index, content_block: { type: "tool_use", id: `call_${index}`, name, input: {} } },
+							{ type: "content_block_stop", index },
+						])
+					: [
+							{ type: "content_block_start", index: 0, content_block: { type: "text", text: "Done" } },
+							{ type: "content_block_stop", index: 0 },
+						]),
+				{ type: "message_delta", delta: { stop_reason: requestBodies.length === 1 ? "tool_use" : "end_turn" }, usage },
+				{ type: "message_stop" },
+			]);
+		};
+		const readTool: AgentTool = {
+			name: "read",
+			label: "Read",
+			description: "Reads a file",
+			parameters: type({}),
+			execute: async () => ({ content: [{ type: "text", text: "MCP fallback ran" }] }),
+		};
+		let unknownCall: ToolCall | undefined;
+		Reflect.set(globalThis, hook, (input: unknown) => {
+			guidanceInputs.push(input);
+			return "test guidance";
+		});
+		try {
+			const stream = agentLoop(
+				[createUserMessage("Check the tool roster")],
+				{ systemPrompt: ["Test"], messages: [], tools: [readTool] },
+				{
+					// A stream may return a different API than the configured model.
+					model: createMockModel({ responses: [] }).model,
+					convertToLlm: messages => messages.filter((m): m is Message => m.role === "user" || m.role === "assistant" || m.role === "toolResult"),
+					resolveFallbackTool: name => name === "mcp_alias" ? readTool : undefined,
+					transformAssistantMessage: message => {
+						unknownCall = message.content.find((block): block is ToolCall => block.type === "toolCall" && block.name === "UnknownTool");
+					},
+					beforeToolCall: async () => {
+						// Simulate a late call-ID change: the first call has no matching prepared entry at dispatch.
+						if (branch === "execute" && unknownCall) unknownCall.id = "late_call";
+					},
+				},
+				undefined,
+				(_model, context) => streamAnthropic(model, context, { apiKey: "sk-ant-test", isOAuth: true, fetch }),
+			);
+			for await (const event of stream) {
+				if (event.type === "message_end" && event.message.role === "toolResult") {
+					resultByName[event.message.toolName] = event.message;
+				}
+			}
+		} finally {
+			if (previous) Object.defineProperty(globalThis, hook, previous);
+			else Reflect.deleteProperty(globalThis, hook);
+		}
+		const roster = [{ name: "_read", description: "Reads a file" }];
+		expect(requestBodies[0]).toMatchObject({ tools: roster });
+		expect(guidanceInputs).toEqual(Array.from({ length: branch === "execute" ? 2 : 1 }, () => ({
+			api: "anthropic-messages", name: "UnknownTool", tools: roster,
+		})));
+		expect(resultByName.UnknownTool).toMatchObject({ isError: true, content: [{ type: "text", text: "test guidance" }] });
+		expect(resultByName.read).toMatchObject({ isError: false, content: [{ type: "text", text: "MCP fallback ran" }] });
+	});
+}
