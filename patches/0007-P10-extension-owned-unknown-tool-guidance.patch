 function formatToolNotFoundMessage(
 	name: string,
+	message: AssistantMessage,
 	tools: ReadonlyArray<Pick<AgentTool, "name" | "customWireName">> | undefined,
 	fallbackNames?: Iterable<string>,
 ): string {
+	const guidance = Reflect.get(globalThis, kUnknownToolGuidance);
+	if (typeof guidance === "function") {
+		try {
+			const result: unknown = guidance({
+				api: message.api,
+				name,
+				tools: (message as RequestToolRosterCarrier)[kRequestToolRoster],
+			});
+			if (typeof result === "string" && result.length > 0) return result;
+		} catch {
+			// Error guidance is advisory: preserve the ordinary miss if the hook fails.
+		}
+	}
 	const suggestions = suggestToolNames(name, tools, fallbackNames);
 	if (suggestions.length === 0) return `Tool ${name} not found`;
 	if (suggestions.length === 1) return `Tool ${name} not found. Did you mean ${suggestions[0]}?`;
@@ -3248,7 +3265,9 @@ async function prepareToolCallDispatch(
 		const validate = (args: Record<string, unknown>): Record<string, unknown> | undefined => {
 			try {
 				if (!tool) {
-					throw new Error(formatToolNotFoundMessage(toolCall.name, context.tools, suggestFallbackToolNames?.()));
+					throw new Error(
+						formatToolNotFoundMessage(toolCall.name, assistantMessage, context.tools, suggestFallbackToolNames?.()),
+					);
 				}
 				return validateAgentToolArguments(tool, { ...toolCall, arguments: args });
 			} catch (validationError) {
@@ -3724,7 +3743,9 @@ async function executeToolCalls(
 		await runInActiveSpan(toolSpan, async () => {
 			try {
 				if (!tool) {
-					throw new Error(formatToolNotFoundMessage(toolCall.name, tools, suggestFallbackToolNames?.()));
+					throw new Error(
+						formatToolNotFoundMessage(toolCall.name, assistantMessage, tools, suggestFallbackToolNames?.()),
+					);
 				}
 				if (abortBeforeToolExecution()) return;
 
diff --git a/packages/agent/test/unknown-tool-guidance.test.ts b/packages/agent/test/unknown-tool-guidance.test.ts
