# Build and run environment for the patched omp. Everything (toolchains, cargo/bun caches, the omp checkout) lives in
# the image or in docker volumes, so nothing is installed on the development host.
# Base: Ubuntu 24.04 (glibc 2.39), which is also the runtime target: natives built here load here.
ARG BASE=ubuntu:24.04
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake ninja-build clang lld git curl ca-certificates unzip xz-utils python3 \
      libssl-dev libx11-dev libxcb1-dev libxkbcommon-dev libdbus-1-dev libwayland-dev libgtk-3-dev libasound2-dev \
    && rm -rf /var/lib/apt/lists/*
# bun is copied from the host (github.com is not reachable from containers here); pin it to the repo's bun version.
COPY bun /usr/local/bin/bun
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
WORKDIR /src
